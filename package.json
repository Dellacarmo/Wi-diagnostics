{
  "name": "rf-space-observatory",
  "version": "1.0.0",
  "description": "🛰️ RF Space Observatory — WiFi Network Diagnostic & 3D Visualization",
  "main": "electron/main.js",
  "scripts": {
    "start": "node start.js",
    "start:nolog": "node start.js --no-log",
    "start:electron": "electron .",
    "start-python": "python python/monitor.py",
    "install-python-deps": "pip install -r python/requirements.txt",
    "dev": "electron . --dev",
    "build": "electron-builder",
    "pack": "electron-builder --dir"
  },
  "author": "Dellacarmo",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.0"
  },
  "build": {
    "appId": "com.dellacarmo.rf-space-observatory",
    "productName": "RF Space Observatory",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "src/**/*",
      "python/**/*",
      "reports/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "src/assets/icon.ico"
    },
    "linux": {
      "target": "AppImage",
      "icon": "src/assets/icon.png"
    },
    "extraResources": [
      {
        "from": "python",
        "to": "python"
      }
    ]
  }
}