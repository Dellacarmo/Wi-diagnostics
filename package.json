{
  "name": "wi-diagnostics",
  "version": "2.0.0",
  "description": "WI//DIAG — visualizador de Wi-Fi: radar no terminal (Bun) e espaço RF 3D no navegador",
  "main": "electron/main.js",
  "bin": {
    "wi": "cli/wi.ts"
  },
  "scripts": {
    "start": "bun cli/wi.ts",
    "cli": "bun cli/wi.ts",
    "demo": "bun cli/wi.ts --demo",
    "web": "bun cli/wi.ts web",
    "web:demo": "bun cli/wi.ts web --demo",
    "scan": "bun cli/wi.ts scan",
    "authorize": "bun cli/wi.ts authorize",
    "oui:update": "bun cli/wi.ts oui update",
    "typecheck": "tsc -p .",
    "electron": "electron .",
    "legacy": "python3 monitor.py",
    "install-python-deps": "pip install -r python/requirements.txt",
    "build": "electron-builder",
    "pack": "electron-builder --dir"
  },
  "author": "Dellacarmo",
  "license": "MIT",
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "bun": "^1.4.4",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.0",
    "typescript": "^7.0.2"
  },
  "build": {
    "appId": "com.dellacarmo.wi-diagnostics",
    "productName": "WI//DIAG",
    "directories": {
      "output": "dist"
    },
    "asar": false,
    "files": [
      "electron/**/*",
      "web/**/*",
      "engine/**/*",
      "cli/**/*",
      "server/**/*",
      "python/**/*",
      "node_modules/three/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    },
    "extraResources": [
      {
        "from": "node_modules/bun/bin/bun.exe",
        "to": "bun/bun.exe"
      }
    ]
  }
}
